{
  "name": "bean-bazaar-trailer",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node capture/capture.mjs",
    "render": "remotion render Trailer out/trailer-render.mp4 --codec=h264 --crf=12 --audio-bitrate=320k --concurrency=2 --offthreadvideo-cache-size-in-bytes=1000000000",
    "engine": "vite build --config capture/engine.vite.config.mjs",
    "game": "vite build ../ --outDir trailer/.game-dist --emptyOutDir",
    "export": "node export.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  }
}
